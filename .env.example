# =============================================================================
# VARIÁVEIS DE AMBIENTE — IzaFit
# Copie este arquivo para `.env.local` e preencha os valores.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (Supabase / PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string do banco de dados.
DATABASE_URL=""
# URL direta para conexões fora do pool (necessária no Supabase).
DIRECT_URL=""

# -----------------------------------------------------------------------------
# SUPABASE — Storage (imagens de produtos, banners, logo)
# -----------------------------------------------------------------------------
# URL pública do projeto Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=""
# Chave pública (anon) — usada no client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Chave de serviço — usada apenas no servidor, NUNCA exponha no client.
# Nota: pode ser omitida em produção se o Storage for acessado via anon + RLS.
SUPABASE_SERVICE_ROLE_KEY=""
# Nome do bucket onde as imagens são armazenadas.
SUPABASE_BUCKET=""
# URL pública do bucket (opcional, se diferente da padrão).
NEXT_PUBLIC_SUPABASE_IMAGE_URL=""

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO (JWT)
# -----------------------------------------------------------------------------
# Segredo usado para assinar os tokens JWT de sessão do cliente.
JWT_SECRET=""

# -----------------------------------------------------------------------------
# MERCADO PAGO — Checkout Transparente (PIX, Cartão de Crédito, Boleto)
# -----------------------------------------------------------------------------
# ATENÇÃO: Enquanto "MERCADO_PAGO_ACCESS_TOKEN" estiver VAZIO, o checkout
# funciona em MODO DE SIMULAÇÃO (gera PIX/boleto fictícios sem chamar a API).
# Para ativar o pagamento real (sandbox ou produção), basta preencher o
# ACCESS_TOKEN abaixo — o servidor passa a chamar a API do Mercado Pago
# automaticamente, sem outras mudanças.
#
# >>> O ÚNICO campo OBRIGATÓRIO para criar pagamentos é o ACCESS_TOKEN. <<<
# Os demais são opcionais (documentados abaixo para referência).
#
# ── Access Token ──
# No painel do Mercado Pago: Desenvolvedores -> Credenciais.
# Em testes (sandbox) começa com "TEST-"; em produção começa com "APP_USR-".
MERCADO_PAGO_ACCESS_TOKEN=""

# ── Public Key (opcional) ──
# Usada no front-end apenas se você tokenizar cartão no navegador (SDK MP).
# NÃO é necessária para PIX/boleto. Pode ficar vazia.
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""

# ── Webhook Secret (opcional) ──
# Segredo para validar as notificações em /api/webhooks/mercadopago.
# Se vazio, as notificações são aceitas sem validação de assinatura
# (recomendável configurar em produção).
MERCADO_PAGO_WEBHOOK_SECRET=""

# ── Dados do painel de Testes do Mercado Pago (NÃO usados pelo código) ──
# Estes campos NÃO são lidos pela aplicação. Servem apenas como referência
# dos dados de sandbox que você tem disponíveis no painel:
#   • Número de aplicação (Application ID / APP_USR)
#   • User ID
#   • Usuários de teste (email + senha + código de verificação)
#
# Para aprovar um pagamento de teste, use o EMAIL e o CPF de um USUÁRIO DE
# TESTE como dados do pagador no checkout. Sem isso, o sandbox rejeita a
# transação.
MP_TEST_APPLICATION_ID=""
MP_TEST_USER_ID=""
