# ============================================================
# BANCO DE DADOS (PostgreSQL — duriante desenvolvimento, o Docker local;
# em produção, o PostgreSQL hospedado do Supabase)
# ============================================================
# Para usar o Supabase como banco, cole aqui a "Connection string"
# (Direct connection) que aparece em Project Settings > Database.
# Formato: postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=""

# ============================================================
# SUPABASE (banco + storage de imagens)
# ============================================================
# Project URL — Project Settings > API
SUPABASE_URL=""

# Service role key (secret) — Project Settings > API > service_role.
# Só deve ser usada no servidor (lib/supabase.ts). NUNCA expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=""
